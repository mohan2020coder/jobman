# Server configuration
APP_ENV=development
APP_PORT=8080

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5433/service_app?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=24h

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Demo/seed users are created with this password in non-production environments
# (override via env if you want a different demo password)
# SEED_PASSWORD=password123